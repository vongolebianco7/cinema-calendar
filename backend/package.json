{
  "name": "cinema-days-backend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node ../scripts/production-checks.cjs && prisma generate && next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:push": "node ../scripts/production-checks.cjs --require && prisma db push",
    "db:sync": "node ../scripts/production-checks.cjs --require && prisma db push && tsx scripts/import-json.ts",
    "db:sync:theaters": "node ../scripts/production-checks.cjs --require && prisma db push && tsx scripts/import-json.ts --theaters-only",
    "db:sync:theater-master": "node ../scripts/production-checks.cjs --require && prisma db push && tsx scripts/import-json.ts --theater-master-only",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@vinext/cloudflare": "^1.4.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.4",
    "deepmerge-ts": "8.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "type": "module"
}
