generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id            String    @id @default(cuid())
  tmdbId        Int?      @unique
  title         String
  originalTitle String?
  posterUrl     String?
  overview      String?
  score         Float?
  votes         Int?
  runtime       Int?
  director      String?
  genres        Json?
  countries     Json?
  releases      Release[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([title])
}

model Release {
  id        String   @id @default(cuid())
  movieId   String
  date      DateTime
  event     String
  service   String
  source    String?
  sourceUrl String?
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([movieId, date, event, service])
  @@index([date])
  @@index([service, date])
}

model TvBroadcast {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  title       String
  date        DateTime
  time        String?
  service     String
  program     String?
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([service, date])
  @@index([title])
}

model TheaterShowtime {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  title       String
  date        DateTime
  theater     String
  area        String?
  screen      String?
  start       String
  end         String?
  sourceUrl   String?
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([theater, date])
  @@index([title])
}


model Theater {
  id           String   @id @default(cuid())
  source       String
  sourceId     String   @unique
  name         String
  prefecture   String?
  municipality String?
  address      String?
  latitude     Float?
  longitude    Float?
  website      String?
  sourceUrl    String
  payload      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([prefecture])
  @@index([municipality])
  @@index([name])
}
