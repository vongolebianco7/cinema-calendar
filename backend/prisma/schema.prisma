generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id            String    @id @default(cuid())
  tmdbId        Int?      @unique
  title         String
  originalTitle String?
  posterUrl     String?
  overview      String?
  score         Float?
  votes         Int?
  runtime       Int?
  director      String?
  genres        Json?
  countries     Json?
  releases      Release[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([title])
}

model Release {
  id        String   @id @default(cuid())
  movieId   String
  date      DateTime
  event     String
  service   String
  source    String?
  sourceUrl String?
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([movieId, date, event, service])
  @@index([date])
  @@index([service, date])
}
