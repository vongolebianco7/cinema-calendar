  "framework": null,
  "buildCommand": "node scripts/build-static.cjs",
  "installCommand": "",
  "outputDirectory": "public",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':(top,glob)*.html' ':(top,glob)*.png' ':(top,glob)*.svg' ':(top,glob)*.webmanifest' ':(top,glob)*.css' ':(top,glob)*.js' ':(top)assets/' ':(top)js/' ':(top)data/' ':(top)preview/' ':(top)my-cinelva/' ':(top)scripts/build-static.cjs' ':(top)vercel.json'",
